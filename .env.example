# Database (use MongoDB Atlas in production)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/homestyle-diner

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-min-32-chars
NEXTAUTH_URL=https://your-domain.vercel.app

# Admin seed (local/scripts only — do not commit real passwords)
ADMIN_SEED_EMAIL=admin@homestylediner.ca
ADMIN_SEED_PASSWORD=ChangeThisSecurePassword123!

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=homestylewaterloo@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Homestyle Diner <homestylewaterloo@gmail.com>
ADMIN_NOTIFICATION_EMAIL=homestylewaterloo@gmail.com

# Public site URL (must match deployed domain)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2896.0!2d-80.535!3d43.466!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s504%20Albert%20St%2C%20Waterloo%2C%20ON!5e0!3m2!1sen!2sca!4v1
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
